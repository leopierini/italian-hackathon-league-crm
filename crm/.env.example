# Bearer token every API call must send (except GET /health and the public UI reads).
CRM_TOKEN=change-me-local-token
# OpenRouter key for the assistant (model openai/gpt-6-luna). Leave empty to run without the assistant.
OPENROUTER_API_KEY=
# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
PORT=3000
# Optional: reasoning effort sent to the model (default low).
AGENTE_REASONING=low
